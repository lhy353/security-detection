# PORTAL_DATASET=all  # 合并 security_merged_v1 + skills_relational_v1；或指定单个数据集名
# GITHUB_REPO=https://github.com/YOUR_USER/security-detection.git
# GITHUB_TOKEN=ghp_xxxxxxxx
# 本地代理（如 Clash 7895），git push 需要；API 不一定需要
# GITHUB_PROXY=http://127.0.0.1:7895
# 门户启动时后台 git pull（不阻塞启动）；有远程更新时页面自动刷新
# GITHUB_AUTO_PULL=1
# 本机上传后自动 commit + push
# GITHUB_AUTO_PUSH=1
